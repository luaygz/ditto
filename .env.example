# Required for spec generation and repair (OpenAI or any OpenAI-compatible endpoint).
OPENAI_API_KEY=
# Optional
# OPENAI_BASE_URL=https://api.openai.com/v1      # OpenRouter, vLLM, Ollama, Together: change this
# OPENAI_MODEL=gpt-6.1-sol                        # default: auto-selected from GET /models
# OPENAI_MODEL_SMALL=gpt-5.4-mini                 # used by --probe-llm and --tail direct
# LLM_BUDGET_USD=40                               # ditto refuses runs projected above the remainder
# ANTHROPIC_API_KEY=                              # native Anthropic adapter (DITTO_MODEL_GENERATION=anthropic/<model>)
