  "permissions": {
    "checked_at": "2026-10-24",
    "assessment": "Usable by third parties for non-commercial research. The release README grants use to whoever downloads it ('By downloading or using this dataset, you agree to the following terms') under non-commercial-research, attribution and license-on-redistribution terms that it says comply with the agreements made with the website providers; the paper requires benchmark users' systems to access the listed URLs (live evaluation), so fetching them is the intended use. ditto uses it for non-commercial research evaluation, keeps release and pages under gitignored data/, and commits only derived field definitions (with the license terms) and this manifest. Each host's robots.txt is obeyed at fetch time; a host whose robots.txt carries Content-Signal ai-input=no is excluded because ditto feeds page content to an LLM.",
    "evidence": [
      {
        "url": "https://arxiv.org/abs/2603.13773",
        "finding": "Abstract: 'Based on trusted and permission-granted websites'; footnote links the dataset at https://github.com/sbY99/LiveWeb-IE."
      },
      {
        "url": "https://arxiv.org/html/2603.13773v1",
        "finding": "Ethics statement: robots.txt and Terms of Use reviewed, administrators contacted for explicit permission 'to include their website in our benchmark'; 'We will release our benchmark under a license that restricts its application to research purposes only'. Sec. 1/3: 'LiveWeb-IE mandates evaluation directly on live websites ... by requiring WIE systems to access the target URL'."
      },
      {
        "url": "https://github.com/sbY99/LiveWeb-IE",
        "finding": "README 'License and Terms of Use' (non-commercial research only, attribution, no redistribution without the license); GitHub API reports no SPDX license; repository holds dataset.json, group.jsonl per site and 179 ground-truth files."
      }
    ]
